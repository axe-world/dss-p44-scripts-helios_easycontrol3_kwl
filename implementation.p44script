// Helios KWL easyControls 3.0 – (Lueftungsprofil: Unterwegs, Zuhause, Intensiv)
// VERIFIED: Four air-temperature registers supplied from Helios register table.
// State IDs contain no spaces; enums are used for digitalSTROM Mobile App.
// States and events are pushed via pushNotification (not message:state/event).
var mb = modbusmaster();
// ttyUSB0 Muss ggf. angepasst werden!! Je nachdem an welchem Port der P44 der Waveshare RS485 to USB Konverter angeschlossen wird
mb.connection("/dev/ttyUSB0:19200,8,E,1", "RS232");   
mb.slave(1);

var previousProfile = null;
var previousHeatExchanger = null;
var previousFilterStatus = null;

function sendState(id, value) {
  var changed = {};
  changed[id] = value;
  message({message:"pushNotification", statechange:changed});
}
function refreshSensors() {
  try {
    var temperature = mb.readreg(4369);
    var humidity = mb.readreg(4370);
    if (temperature == 65535 || humidity == 65535 ||
        temperature < 0 || temperature > 80 || humidity < 0 || humidity > 100) {
      throw "Helios sensor reading invalid or outside expected range";
    }
    message({message:"sensor", id:"temperature", value:temperature});
    message({message:"sensor", id:"humidity", value:humidity});
    message({message:"opstate", level:100, text:"Modbus OK"});
  }
  catch as e {
    log(3, "Helios KWL sensor polling failed: " + e);
    message({message:"sensor", id:"temperature", value:null});
    message({message:"sensor", id:"humidity", value:null});
    message({message:"opstate", level:0, text:"Modbus error"});
  }
}
function refreshProfile() {
  try {
    // 4609: 0 = Zuhause, 1 = Unterwegs.
    // 4612: remaining intensive-ventilation boost time in minutes;
    //       65535 = permanent boost.
    // 21766: timer enabled (0 = off, 1 = on).
    // "Individuell" is not available through these Modbus registers.
    var p = mb.readreg(4609);
    var boostMinutes = mb.readreg(4612);
    var timerEnabled = mb.readreg(21766);
    var profile = null;
    // Permanent boost or an enabled, still-running timed boost.
    if (boostMinutes == 65535 ||
        (timerEnabled == 1 && boostMinutes > 0 && boostMinutes < 65535)) {
      profile = "Intensiv";
    }
    else if (p == 0) profile = "Zuhause";
    else if (p == 1) profile = "Unterwegs";
    else log(4, "Helios KWL unknown profile register value: " + p);
    if (profile != null) {
      sendState("Lueftungsprofil", profile);
      if (previousProfile != null && previousProfile != profile) {
        message({message:"pushNotification", events:["Moduswechsel"]});
      }
      previousProfile = profile;
    }
  }
  catch as e {
    log(3, "Helios KWL profile polling failed: " + e);
  }
}
// Helios temperature registers in centiKelvin (cK):
// 4354 = exhaust extract air (Abluft)
// 4355 = exhaust discharge air (Fortluft)
// 4356 = outdoor air (Aussenluft)
// 4358 = supply air (Zuluft)
// Celsius = raw / 100 - 273.15
// The enum supports only integral values 5..35, so round to nearest integer.
// Invalid and out-of-enum readings are NOT clamped to 5 or 35.
function refreshAirTemperatures() {
  var regs = [4354, 4355, 4356, 4358];
  var ids = ["Ablufttemperatur", "Fortlufttemperatur",
             "Aussenlufttemperatur", "Zulufttemperatur"];
  for (var i = 0; i < 4; i++) {
    try {
      var raw = mb.readreg(regs[i]);
      if (raw == 65535 || raw < 0 || raw > 65535) {
        throw "Invalid centiKelvin reading: " + raw;
      }
      var celsius = raw / 100 - 273.15;
      var rounded = round(celsius);
      if (rounded < 5 || rounded > 35) {
        log(4, "Helios KWL " + ids[i] + " outside enum 5..35: " + celsius + " C");
      }
      else {
        // digitalSTROM mobile: state value must match declared enum string.
        sendState(ids[i], "" + rounded);
      }
    }
    catch as e {
      log(3, "Helios KWL temperature register " + regs[i] + " failed: " + e);
    }
  }
}
// Register 4616 CELL_STATE: 0 = WRG, 1 = KRG, 2 = Bypass.
// Event Bypass triggers on transition to Bypass.
// Events RueckgewinnungWRG / RueckgewinnungKRG trigger on transitions
// from Bypass to WRG / KRG respectively.
// A transition WRG <-> KRG updates the state but does not trigger a bypass event.
// No transition event is fired on the initial reading.
function refreshHeatExchanger() {
  try {
    var raw = mb.readreg(4616);
    var status = null;
    if (raw == 0) status = "WRG";
    else if (raw == 1) status = "KRG";
    else if (raw == 2) status = "Bypass";
    else {
      log(4, "Helios KWL unknown CELL_STATE: " + raw);
      return;
    }
    sendState("Waermetauscher", status);
    if (previousHeatExchanger != null && previousHeatExchanger != status) {
      if (status == "Bypass") {
        message({message:"pushNotification", events:["Bypass"]});
      }
      else if (previousHeatExchanger == "Bypass" && status == "WRG") {
        message({message:"pushNotification", events:["RueckgewinnungWRG"]});
      }
      else if (previousHeatExchanger == "Bypass" && status == "KRG") {
        message({message:"pushNotification", events:["RueckgewinnungKRG"]});
      }
    }
    previousHeatExchanger = status;
  }
  catch as e {
    log(3, "Helios KWL heat exchanger polling failed: " + e);
  }
}
// Filter status from date of last filter change and interval (in days).
// 20546 = FILTER_CHANGED_DAY (1..31)
// 20547 = FILTER_CHANGED_MONTH (1..12)
// 20548 = FILTER_CHANGED_YEAR (0..99, two-digit year)
// 20537 = FILTER_CHANGE_INTERVAL (30..365 days)
// Two-digit year interpreted as last occurrence in the past (1900/2000).
// Use local calendar midnight timestamps to determine elapsed whole calendar days.
// State IDs have no spaces and values are enumerations for dS Mobile.
function refreshFilterStatus() {
  try {
    var changedDay = mb.readreg(20546);
    var changedMonth = mb.readreg(20547);
    var changedYear2 = mb.readreg(20548);
    var intervalDays = mb.readreg(20537);
    if (changedDay < 1 || changedDay > 31 ||
        changedMonth < 1 || changedMonth > 12 ||
        changedYear2 < 0 || changedYear2 > 99 ||
        intervalDays < 30 || intervalDays > 365) {
      throw "Invalid filter date or interval registers";
    }
    var now = epochtime();
    var currentYear = year(now);
    var changedYear = 2000 + changedYear2;
    if (changedYear > currentYear) changedYear = changedYear - 100;
    var lastChange = epochtime(0, 0, 0, changedDay, changedMonth, changedYear);
    // Reject invalid dates (e.g. 31 February) and dates in the future.
    if (day(lastChange) != changedDay || month(lastChange) != changedMonth ||
        year(lastChange) != changedYear || lastChange > now) {
      throw "Invalid last filter-change date";
    }
    // Compare date-only values (local day counts), avoiding hour-of-day drift.
    // Epoch seconds / 86400 at local midnights can differ across DST changes:
    // use 12:00 local time and p44script round() for calendar-day count.
    var elapsedDays = round((epochtime(12, 0, 0, day(now), month(now), currentYear) -
                             epochtime(12, 0, 0, changedDay, changedMonth, changedYear)) / 86400);
    var status = "OK";
    if (elapsedDays >= intervalDays) status = "Fällig";
    sendState("Filterwechsel", status);
    if (previousFilterStatus == "OK" && status == "Fällig") {
      message({message:"pushNotification", events:["Filterwechsel"]});
    }
    previousFilterStatus = status;
  }
  catch as e {
    log(3, "Helios KWL filter status polling failed: " + e);
  }
}

function runAction(actionName) {
  if (actionName == "Boost") {
    mb.writereg(4612, 65535);
    mb.writereg(21766, 0);
  }
  else if (actionName == "Boost30min") {
    mb.writereg(4612, 30);
    mb.writereg(21766, 1);
  }
  else if (actionName == "Away") {
    mb.writereg(21766, 0);
    mb.writereg(4612, 0);
    mb.writereg(4609, 1);
  }
  else if (actionName == "Home") {
    mb.writereg(21766, 0);
    mb.writereg(4612, 0);
    mb.writereg(4609, 0);
  }
  else throw "Unknown Helios action: " + actionName;
  log(5, "Helios KWL action executed: %s", actionName);
}
on (message()) as m {
  if (m.message == "invokeAction") {
    try {
      runAction(m.action);
      message({message:"confirmAction", action:m.action, errorcode:0});
      refreshProfile();
      refreshAirTemperatures();
      refreshHeatExchanger();
      refreshFilterStatus();
    }
    catch as e {
      log(3, "Helios KWL action failed: " + e);
      message({message:"confirmAction", action:m.action, errorcode:1,
        errortext:"Modbus write failed"});
      message({message:"opstate", level:0, text:"Modbus error"});
    }
  }
}
on (every(0:01)) {
  refreshSensors();
  refreshProfile();
  refreshAirTemperatures();
  refreshHeatExchanger();
  refreshFilterStatus();
}
refreshSensors();
refreshProfile();
refreshAirTemperatures();
refreshHeatExchanger();
refreshFilterStatus();
return true;
